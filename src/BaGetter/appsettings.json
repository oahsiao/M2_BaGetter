{
  "ApiKey": "",
  "PackageDeletionBehavior": "Unlist",
  "AllowPackageOverwrites": false,
  "MaxPackageSizeGiB": 8,
  "RegistrationPageSize": 32,

  "Database": {
    "Type": "Sqlite",
    "ConnectionString": "Data Source=bagetter.db"
  },

  "Storage": {
    "Type": "FileSystem",
    "Path": ""
  },

  "Search": {
    "Type": "Database"
  },

  "Mirror": {
    "Enabled": false,
    "PackageSource": "https://api.nuget.org/v3/index.json"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },

  "HealthCheck": {
    "Path": "/health"
  },

  "Statistics": {
    "EnableStatisticsPage": true,
    "ListConfiguredServices": true
  },

  "RequestRateLimit": {
    "Enabled": false,
    "PermitLimit": 120,
    "WindowSeconds": 60,
    "QueueLimit": 0
  },

  "Cors": {
    "AllowAnyOrigin": true,
    "AllowedOrigins": [],
    "AllowAnyMethod": true,
    "AllowedMethods": [],
    "AllowAnyHeader": true,
    "AllowedHeaders": [],
    "AllowCredentials": false
  },

  "SecurityHeaders": {
    "Enabled": true,
    "EnableHsts": false,
    "HstsMaxAgeDays": 365,
    "HstsIncludeSubDomains": true,
    "HstsPreload": false
  },

  "Localization": {
    "Enabled": true
  },

  "Reindex": {
    "Enabled": false,
    "RunOnStartup": false,
    "IntervalMinutes": 0,
    "BatchSize": 100
  },

  "Authentication": {
    "Ldap": {
      "Enabled": true,
      "Server": "192.168.100.168",
      "Port": 389,
      "BaseDn": "dc=M2LDAP",
      "UserSearchBase": "cn=users,dc=M2LDAP",
      "UserSearchFilter": "(&(objectClass=inetOrgPerson)(uid=%s))",
      "BindDn": "uid=admin,cn=users,dc=M2LDAP",
      "BindPassword": "change-me",
      "UseSsl": false,
      "AllowedGroups": []
    }
  }
}